// Pjesme aplikacije na Cloudflareu (workers.dev): fajlovi su statični (assets),
// a /audio/* prvo prolazi kroz src/index.js — dijelovi pjesme (Range) i CORS.
// Besplatno: 100.000 zahtjeva dnevno; telefon svaku pjesmu preuzme jednom.
// Objava: npm run audio:deploy (scripts/deploy-audio.sh). Prvi put: npx wrangler login
{
  "name": "stihdana-audio",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/audio/*"] }
}
